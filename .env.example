# Neo4j Configuration
# On-prem / local:  NEO4J_URI=bolt://localhost:7687
# Neo4j Aura cloud: NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
# HTTP API port used for agent tooling (7474 for local, 443 for Aura)
NEO4J_HTTP_PORT=7474

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here

# Corporate / proxy SSL workaround
# If you see: [SSL: CERTIFICATE_VERIFY_FAILED] self-signed certificate in certificate chain
#   Option A — point to your corporate CA bundle (recommended):
#     LLM_SSL_VERIFY=C:\path\to\corporate-ca-bundle.pem
#   Option B — disable SSL verification entirely (less secure):
#     LLM_SSL_VERIFY=false
# Leave unset (or "true") for default certificate verification.
#LLM_SSL_VERIFY=true

# Migration Settings
COBOL_SOURCE_DIR=./cobol_samples
MAPA_CSV_PATH=./cobol_samples/result.csv
OUTPUT_DIR=./output
LOG_LEVEL=INFO
MAX_PARALLEL_AGENTS=5
LLM_MODEL=claude-sonnet-4-6

# MAPA JAR — static analysis tool that scans COBOL source and produces result.csv
# Repo   : https://github.com/cschneid-the-elder/mapa
# The JAR is auto-downloaded from MAPA_JAR_URL if MAPA_JAR_PATH does not exist.
# Set MAPA_AUTO_DOWNLOAD=false if you are in an air-gapped / offline environment.
MAPA_JAR_PATH=./CallTree.jar
MAPA_JAR_URL=https://github.com/cschneid-the-elder/mapa/raw/refs/heads/master/cobol/CallTree.jar
MAPA_AUTO_DOWNLOAD=true
MAPA_JAVA_EXECUTABLE=java
MAPA_JVM_OPTS=-Xmx2g
MAPA_COPYBOOK_DIR=
