       IDENTIFICATION DIVISION.
       PROGRAM-ID. POLICY.
       AUTHOR. MIGRATION-DEMO.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-POLICY-TYPE        PIC X(10).
       01 WS-BASE-RATE          PIC 9(5)V99.
       01 WS-AGE-FACTOR         PIC 9(3)V99.
       01 WS-FINAL-PREMIUM      PIC 9(7)V99.
       01 WS-DISCOUNT-RATE      PIC 9(3)V99.
       01 WS-TAX-RATE           PIC 9(3)V99.
       01 WS-POLICY-STATUS      PIC X(2).
          88 POLICY-ACTIVE      VALUE 'AC'.
          88 POLICY-LAPSED      VALUE 'LA'.

       LINKAGE SECTION.
       01 LS-POLICY-ID          PIC X(10).
       01 LS-RESULT-CODE        PIC 9(2).

       PROCEDURE DIVISION USING LS-POLICY-ID LS-RESULT-CODE.

       MAIN-PARA.
           PERFORM VALIDATE-POLICY
           IF POLICY-ACTIVE
               PERFORM CALCULATE-PREMIUM
               PERFORM APPLY-DISCOUNT
               PERFORM APPLY-TAX
           ELSE
               MOVE 99 TO LS-RESULT-CODE
           END-IF
           STOP RUN.

       VALIDATE-POLICY.
           EXEC SQL
               SELECT POLICY_STATUS INTO :WS-POLICY-STATUS
               FROM POLICIES
               WHERE POLICY_ID = :LS-POLICY-ID
           END-EXEC
           IF SQLCODE NOT = 0
               MOVE 'LA' TO WS-POLICY-STATUS
           END-IF.

       CALCULATE-PREMIUM.
           MOVE 'HOME' TO WS-POLICY-TYPE
           MOVE 500.00 TO WS-BASE-RATE
           MOVE 1.25   TO WS-AGE-FACTOR
           COMPUTE WS-FINAL-PREMIUM = WS-BASE-RATE * WS-AGE-FACTOR.

       APPLY-DISCOUNT.
           MOVE 10.00 TO WS-DISCOUNT-RATE
           COMPUTE WS-FINAL-PREMIUM =
               WS-FINAL-PREMIUM - (WS-FINAL-PREMIUM * WS-DISCOUNT-RATE / 100).

       APPLY-TAX.
           MOVE 8.00 TO WS-TAX-RATE
           COMPUTE WS-FINAL-PREMIUM =
               WS-FINAL-PREMIUM + (WS-FINAL-PREMIUM * WS-TAX-RATE / 100).
