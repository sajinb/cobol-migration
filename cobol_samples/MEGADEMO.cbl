IDENTIFICATION DIVISION.
PROGRAM-ID. MEGADEMO.
*> AUTHOR.      SAJIN TEST PACK (GENERATED)   -- removed: breaks CallTree parser
*> INSTALLATION.SYNECHRON LAB                 -- removed: breaks CallTree parser
*> DATE-WRITTEN.2026-03-05                    -- removed: breaks CallTree parser
*> DATE-COMPILED.                             -- removed: breaks CallTree parser
*> REMARKS. A comprehensive COBOL program to exercise many language constructs
*>          for migration testing to Java.
ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
SOURCE-COMPUTER. IBM-Z-SERIES.
*>   WITH DEBUGGING MODE removed — not supported by CallTree parser
OBJECT-COMPUTER. X86-64.
*>   WITH ARITHMETIC IS NATIVE removed — not supported by CallTree parser
SPECIAL-NAMES.
*>   CR removed — reserved keyword in ANTLR grammar; renamed to CRET/LFD
     CLASS DIGIT-ONLY IS "0" THRU "9"
     SYMBOLIC CHARACTERS
          LFD IS 10
          CRET IS 13
          F1  IS 49
     ALPHABET EBCDIC IS STANDARD-1.
*>   COLLATING SEQUENCE IS EBCDIC removed — not supported by CallTree parser
INPUT-OUTPUT SECTION.
FILE-CONTROL.
     SELECT INSEQ ASSIGN TO "data/inseq.txt"
            ORGANIZATION IS SEQUENTIAL
            ACCESS MODE IS SEQUENTIAL
            FILE STATUS IS WS-FS-INSEQ.
     SELECT RELFILE ASSIGN TO "data/relfile.dat"
            ORGANIZATION IS RELATIVE
            RELATIVE KEY IS WS-REL-KEY
            ACCESS MODE IS DYNAMIC
            FILE STATUS IS WS-FS-REL.
     SELECT IXFILE ASSIGN TO "data/ixfile.dat"
            ORGANIZATION IS INDEXED
            ACCESS MODE IS DYNAMIC
            RECORD KEY IS IX-KEY
            ALTERNATE RECORD KEY IS IX-AK1 WITH DUPLICATES
            FILE STATUS IS WS-FS-IX.
     SELECT SORTWK ASSIGN TO "data/sort.tmp".
DATA DIVISION.
FILE SECTION.
FD  INSEQ
    RECORD CONTAINS 120 CHARACTERS
    BLOCK CONTAINS 0 RECORDS.
01  INSEQ-REC.
    05  INSEQ-ID              PIC 9(6).
    05  FILLER                PIC X(2).
    05  INSEQ-NAME            PIC X(30).
    05  INSEQ-AMT             PIC S9(7)V99.
    05  INSEQ-DATE            PIC 9(8).
    05  INSEQ-COMMENT         PIC X(70).
FD  RELFILE.
01  REL-REC.
    05  REL-ID                PIC 9(6).
    05  REL-DATA              PIC X(50).
FD  IXFILE.
01  IX-REC.
    05  IX-KEY                PIC X(10).
    05  IX-AK1                PIC X(5).
    05  IX-AMT                PIC S9(7)V99 COMP-3.
    05  IX-DATE               PIC 9(8).
SD  SORT-FILE.
01  SORT-REC.
    05  S-KEY                 PIC X(10).
    05  S-DATA                PIC X(50).
WORKING-STORAGE SECTION.
77  WS-FS-INSEQ               PIC XX   VALUE SPACES.
77  WS-FS-REL                 PIC XX   VALUE SPACES.
77  WS-FS-IX                  PIC XX   VALUE SPACES.
77  WS-LAST-FS                PIC XX   VALUE SPACES.
77  WS-REL-KEY                PIC 9(6) VALUE 0.
77  WS-RUN-MODE               PIC X    VALUE 'D'.
    88 WS-DEBUG                        VALUE 'D'.
    88 WS-PROD                         VALUE 'P'.
77  WS-POINTER                USAGE POINTER.
77  WS-IDX-COMP               PIC 9(4) COMP VALUE 0.
77  WS-IDX-BIN                PIC 9(4) BINARY VALUE 0.
01  WS-AMOUNTS.
    05  WS-AMT-DISPLAY        PIC Z,ZZZ,ZZ9.99-.
    05  WS-AMT-STAR           PIC **,***,**9.99.
    05  WS-AMT-CRDB           PIC $$,$$$,$$9.99CR.
01  WS-EDITED-EXAMPLES.
    05  WS-DATE-YYYYMMDD      PIC 9(8).
    05  WS-DATE-PRINT         PIC Z9/99/99.
    05  WS-ALNUM              PIC X(12).
    05  WS-UNSTR-SRC          PIC X(8)  VALUE 'A|B|C|D'.
    05  WS-IX-START-KEY       PIC X(10) VALUE 'K000000000'.
01  WS-EMP-BLOCK.
    COPY COMMON-RECORDS.
01  WS-TABLE-BIG.
    05  WS-TBL-COUNT          PIC 9(4) COMP VALUE 10.
    05  WS-TBL                OCCURS 1 TO 100 DEPENDING ON WS-TBL-COUNT
                              INDEXED BY WS-TBL-IDX.
        10  WS-TBL-KEY        PIC X(10).
        10  WS-TBL-VAL        PIC S9(7)V99 COMP-3.
01  WS-RENAMES-DEMO.
    05  RN-A                  PIC X(3).
    05  RN-B                  PIC X(3).
    05  RN-C                  PIC X(3).
    05  RN-D                  PIC X(3).
66  RN-AB RENAMES RN-A THRU RN-B.
66  RN-BC RENAMES RN-B THRU RN-C.
01  WS-FLAGS.
    05  WS-FLAG-AREA          PIC X VALUE 'N'.
        88  FLAG-YES          VALUE 'Y'.
        88  FLAG-NO           VALUE 'N'.
01  WS-COPY-MESSAGES.
    COPY MESSAGES.
PROCEDURE DIVISION.
MAIN-SECTION SECTION.
MAIN-ENTRY.
    DISPLAY MSG-INFO-PREFIX 'Program start: ' FUNCTION CURRENT-DATE
    IF WS-DEBUG
       DISPLAY MSG-INFO-PREFIX 'Debug mode enabled.'
    END-IF
    PERFORM INIT-FILES-AND-DATA
    PERFORM TABLE-OPS
    PERFORM STRING-AND-EDITING-OPS
    PERFORM ARITHMETIC-AND-FUNCTIONS
    PERFORM INDEXED-FILE-OPS
    PERFORM RELATIVE-FILE-OPS
    PERFORM SEQ-FILE-AND-SORT-OPS
    PERFORM CONTROL-FLOW-DEMO
    PERFORM CALLS-AND-POINTERS
    DISPLAY MSG-INFO-PREFIX 'Program end:   ' FUNCTION CURRENT-DATE
    GOBACK.
INIT-FILES-AND-DATA SECTION.
INIT-1.
    OPEN OUTPUT INSEQ
    OPEN I-O IXFILE
    OPEN I-O RELFILE
    IF WS-FS-IX NOT = '00'
       OPEN OUTPUT IXFILE
       CLOSE IXFILE
       OPEN I-O IXFILE
    END-IF
    MOVE 'Y' TO WS-FLAG-AREA
    SET FLAG-YES TO TRUE
    MOVE 10 TO WS-TBL-COUNT
    PERFORM VARYING WS-IDX-BIN FROM 1 BY 1 UNTIL WS-IDX-BIN > WS-TBL-COUNT
       SET WS-TBL-IDX TO WS-IDX-BIN
       STRING 'KEY' DELIMITED BY SIZE
              WS-IDX-BIN DELIMITED BY SIZE
              INTO WS-TBL-KEY (WS-TBL-IDX)
       END-STRING
       COMPUTE WS-TBL-VAL (WS-TBL-IDX) = (WS-IDX-BIN * 13.37)
    END-PERFORM
    MOVE 'ABC' TO RN-A
    MOVE 'DEF' TO RN-B
    MOVE 'GHI' TO RN-C
    MOVE 'JKL' TO RN-D
    MOVE 5 TO TBL-COUNT
    MOVE 'AA00000001' TO TBL-ITEM-KEY (1)
    MOVE 100.50 TO TBL-ITEM-AMT (1)
    MOVE 'AA00000002' TO TBL-ITEM-KEY (2)
    MOVE 200.75 TO TBL-ITEM-AMT (2)
    EXIT SECTION.
TABLE-OPS SECTION.
TBL-1.
    SET TBL-IDX TO 1
    PERFORM UNTIL TBL-IDX > TBL-COUNT
       DISPLAY 'TBL ITEM (' TBL-IDX ') KEY=' TBL-ITEM-KEY (TBL-IDX)
       SET TBL-IDX UP BY 1
    END-PERFORM
    SEARCH TBL-ITEM
       AT END DISPLAY 'LINEAR SEARCH: NOT FOUND'
       WHEN TBL-ITEM-KEY (TBL-IDX) (1:2) = 'AA'
            DISPLAY 'LINEAR SEARCH FOUND INDEX=' TBL-IDX
    END-SEARCH
    MOVE 5 TO TBL-COUNT
    SET TBL-IDX TO 1
    SEARCH ALL TBL-ITEM
       WHEN TBL-ITEM-KEY (TBL-IDX) = 'AA00000002'
            DISPLAY 'BINARY SEARCH FOUND IDX=' TBL-IDX
    END-SEARCH
    EXIT SECTION.
STRING-AND-EDITING-OPS SECTION.
STR-1.
    MOVE '20260305' TO WS-DATE-YYYYMMDD
    MOVE WS-DATE-YYYYMMDD (1:2) TO WS-DATE-PRINT (1:2)
    MOVE WS-DATE-YYYYMMDD (3:2) TO WS-DATE-PRINT (4:2)
    MOVE WS-DATE-YYYYMMDD (5:2) TO WS-DATE-PRINT (7:2)
    STRING 'Hello, ' EMP-FNAME ' ' EMP-LNAME '!' DELIMITED BY SIZE
           INTO WS-ALNUM
    END-STRING
*>   UNSTRING source must be identifier, not literal — use WS-UNSTR-SRC
    UNSTRING WS-UNSTR-SRC DELIMITED BY '|'
             INTO RN-A RN-B RN-C RN-D
    INSPECT WS-ALNUM TALLYING WS-IDX-COMP FOR ALL 'L'
    INSPECT WS-ALNUM REPLACING ALL '!' BY '.'
    MOVE 123456.78 TO WS-AMT-DISPLAY
    MOVE 123456.78 TO WS-AMT-STAR
    MOVE -123456.78 TO WS-AMT-CRDB
    DISPLAY 'Edited Amt 1: ' WS-AMT-DISPLAY
    DISPLAY 'Edited Amt 2: ' WS-AMT-STAR
    DISPLAY 'Edited Amt 3: ' WS-AMT-CRDB
    EXIT SECTION.
ARITHMETIC-AND-FUNCTIONS SECTION.
ARI-1.
    COMPUTE IX-AMT = (13 + 7) * 2 - 5 / 2
    DISPLAY 'COMPUTE IX-AMT=' IX-AMT
    DISPLAY 'CURRENT-DATE=' FUNCTION CURRENT-DATE
    DISPLAY 'MAX(3,7)=' FUNCTION MAX(3 7)
    DISPLAY 'MIN(3,7)=' FUNCTION MIN(3 7)
    DISPLAY 'RANDOM=' FUNCTION RANDOM
    DISPLAY 'LENGTH(WS-ALNUM)=' FUNCTION LENGTH(WS-ALNUM)
    DISPLAY 'UPPER-CASE=' FUNCTION UPPER-CASE('abc')
    DISPLAY 'LOWER-CASE=' FUNCTION LOWER-CASE('ABC')
    DISPLAY 'INTEGER-OF-DATE(20260305)=' FUNCTION INTEGER-OF-DATE(20260305)
    DISPLAY 'DATE-OF-INTEGER(75000)=' FUNCTION DATE-OF-INTEGER(75000)
*>   EVALUATE ... ALSO ... multi-subject form not supported — simplified
    EVALUATE EMP-GRADE
      WHEN 'A'
         DISPLAY 'EVALUATE: Grade A'
      WHEN OTHER
         DISPLAY 'EVALUATE: default path'
    END-EVALUATE
    EXIT SECTION.
INDEXED-FILE-OPS SECTION.
IX-1.
    MOVE 'K000000001' TO IX-KEY
    MOVE 'AK001'      TO IX-AK1
    MOVE 1111.11      TO IX-AMT
    MOVE 20260305     TO IX-DATE
    WRITE IX-REC INVALID KEY
      DISPLAY MSG-ERR-PREFIX 'IX WRITE FAILED FS=' WS-FS-IX
    END-WRITE
*>   START KEY comparison requires identifier, not literal — use WS-IX-START-KEY
    START IXFILE KEY >= WS-IX-START-KEY INVALID KEY CONTINUE END-START
    READ IXFILE NEXT RECORD AT END CONTINUE END-READ
    REWRITE IX-REC INVALID KEY
      DISPLAY MSG-ERR-PREFIX 'IX REWRITE FAILED FS=' WS-FS-IX
    END-REWRITE
    DELETE IXFILE RECORD INVALID KEY
      DISPLAY MSG-ERR-PREFIX 'IX DELETE FAILED FS=' WS-FS-IX
    END-DELETE
    EXIT SECTION.
RELATIVE-FILE-OPS SECTION.
REL-1.
    MOVE 1 TO WS-REL-KEY
    MOVE 1 TO REL-ID
    MOVE 'RELATIVE DATA' TO REL-DATA
    WRITE REL-REC INVALID KEY
      DISPLAY MSG-ERR-PREFIX 'REL WRITE FAILED FS=' WS-FS-REL
    END-WRITE
    READ RELFILE RECORD INTO REL-REC INVALID KEY
      DISPLAY MSG-ERR-PREFIX 'REL READ FAILED FS=' WS-FS-REL
    END-READ
    EXIT SECTION.
SEQ-FILE-AND-SORT-OPS SECTION.
SQ-1.
    MOVE 1 TO INSEQ-ID
    MOVE 'John Doe' TO INSEQ-NAME
    MOVE 9999.99 TO INSEQ-AMT
    MOVE 20260305 TO INSEQ-DATE
    MOVE 'Sample record' TO INSEQ-COMMENT
    WRITE INSEQ-REC
    CLOSE INSEQ
    SORT SORT-FILE ON ASCENDING KEY S-KEY
         INPUT PROCEDURE IS SORT-IN-PROC
         OUTPUT PROCEDURE IS SORT-OUT-PROC.
    EXIT SECTION.
SORT-IN-PROC SECTION.
SIP-1.
    RELEASE SORT-REC FROM INSEQ-REC
    EXIT SECTION.
SORT-OUT-PROC SECTION.
SOP-1.
    RETURN SORT-FILE RECORD INTO SORT-REC AT END GO TO SOP-EXIT
    DISPLAY 'SORTED:' S-KEY ' -> ' S-DATA
    GO TO SOP-1
SOP-EXIT.
    EXIT SECTION.
CONTROL-FLOW-DEMO SECTION.
CFD-1.
    PERFORM VARYING WS-IDX-COMP FROM 1 BY 1 UNTIL WS-IDX-COMP > 3
       DISPLAY 'PERFORM VARYING i=' WS-IDX-COMP
    END-PERFORM
    MOVE 2 TO WS-IDX-COMP
    EVALUATE WS-IDX-COMP
        WHEN 1
             DISPLAY 'EVAL: one'
        WHEN 2
             DISPLAY 'EVAL: two'
        WHEN OTHER
             DISPLAY 'EVAL: other'
    END-EVALUATE
    GO TO DEPENDING-ON-DEMO.
DEPENDING-ON-DEMO.
    MOVE 3 TO WS-IDX-COMP
    GO TO LABEL-1 LABEL-2 LABEL-3 DEPENDING ON WS-IDX-COMP.
LABEL-1.
    DISPLAY 'GO TO DEPENDING ON -> 1'
    GO TO CFD-EXIT.
LABEL-2.
    DISPLAY 'GO TO DEPENDING ON -> 2'
    GO TO CFD-EXIT.
LABEL-3.
    DISPLAY 'GO TO DEPENDING ON -> 3'.
CFD-EXIT.
    ALTER OLD-PARAGRAPH TO PROCEED TO NEW-PARAGRAPH.
OLD-PARAGRAPH.
    DISPLAY 'This will be altered.'.
NEW-PARAGRAPH.
    DISPLAY 'ALTER redirected here.'
    EXIT SECTION.
CALLS-AND-POINTERS SECTION.
CAP-1.
    SET ADDRESS OF REL-REC TO WS-POINTER
    DISPLAY 'POINTER ADDR=' WS-POINTER
    CALL 'SUBPGM1' USING BY REFERENCE EMP-ID
                         BY CONTENT  WS-ALNUM
                         BY VALUE    WS-IDX-COMP
    CANCEL 'SUBPGM1'
    MOVE 'SYSTEM' TO WS-ALNUM (1:6)
    CALL WS-ALNUM USING BY CONTENT 'echo DYNAMIC CALL'
    DISPLAY 'Dynamic CALL executed (if supported).'
    EXIT SECTION.