DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cobol_migration

# Root of the cobol-migration repo — auto-detected from __file__ if not set.
# Set this when the api is deployed separately from the pipeline code.
# Linux/Mac example:
COBOL_MIGRATION_DIR=/home/user/cobol-migration
# Windows example:
# COBOL_MIGRATION_DIR=C:\cobol-migration

# Optional: explicit path to main.py when it doesn't live inside COBOL_MIGRATION_DIR.
# Leave blank to use COBOL_MIGRATION_DIR/main.py (the default).
# PIPELINE_MAIN_PY=C:\cobol-migration\main.py

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
